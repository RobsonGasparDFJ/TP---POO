<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import view.PalcoCassino?>

<!-- Aba do cassino. É incluída em dashboard.fxml por <fx:include>; as cores e classes vêm de estilo.css. -->
<HBox spacing="18.0" style="-fx-background-color: #F5F3EF; -fx-padding: 4 0 0 0;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ControleCassino">
   <children>

      <!-- Jogar -->
      <VBox minWidth="340.0" prefWidth="340.0" maxWidth="340.0" spacing="10.0" styleClass="content-card">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="8.0">
               <children>
                  <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="card-title" text="Cassino" />
                        <Label styleClass="card-subtitle" text="Aposte o saldo da conta selecionada." />
                     </children>
                  </VBox>
                  <FontIcon iconLiteral="fas-dice" iconSize="18" styleClass="muted-icon" />
               </children>
            </HBox>

            <VBox fx:id="painelControles" spacing="10.0">
               <children>
                  <Label styleClass="card-subtitle" text="JOGO" />
                  <FlowPane fx:id="caixaJogos" hgap="6.0" vgap="6.0" />
                  <Label fx:id="labelRegras" styleClass="card-subtitle" wrapText="true" minHeight="-Infinity" />
                  <Label fx:id="labelRetorno" styleClass="card-subtitle" wrapText="true" minHeight="-Infinity" />

                  <VBox fx:id="caixaEscolha" spacing="6.0">
                     <children>
                        <Label styleClass="card-subtitle" text="SUA ESCOLHA" />
                        <FlowPane fx:id="caixaOpcoes" hgap="6.0" vgap="6.0" />
                     </children>
                  </VBox>

                  <Label styleClass="card-subtitle" text="VALOR DA APOSTA" />
                  <TextField fx:id="campoValor" onAction="#apostar" promptText="Valor (R$)" styleClass="transfer-input" />
                  <FlowPane hgap="6.0" vgap="6.0">
                     <children>
                        <Button mnemonicParsing="false" onAction="#valorRapido" styleClass="opcao-cassino" text="R$ 10" userData="10" />
                        <Button mnemonicParsing="false" onAction="#valorRapido" styleClass="opcao-cassino" text="R$ 50" userData="50" />
                        <Button mnemonicParsing="false" onAction="#valorRapido" styleClass="opcao-cassino" text="R$ 100" userData="100" />
                        <Button mnemonicParsing="false" onAction="#valorRapido" styleClass="opcao-cassino" text="Metade" userData="METADE" />
                        <Button mnemonicParsing="false" onAction="#valorRapido" styleClass="opcao-cassino" text="Máximo" userData="MAXIMO" />
                     </children>
                  </FlowPane>
                  <Label fx:id="labelLimites" styleClass="card-subtitle" />

                  <VBox fx:id="caixaAutomatica" managed="false" spacing="6.0" visible="false">
                     <children>
                        <Label styleClass="card-subtitle" text="RETIRADA AUTOMÁTICA (OPCIONAL)" />
                        <TextField fx:id="campoAutomatico" onAction="#apostar" promptText="Ex.: 2,00" styleClass="transfer-input" />
                     </children>
                  </VBox>

                  <Button fx:id="botaoApostar" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#apostar" styleClass="transfer-button" text="APOSTAR" />
               </children>
            </VBox>
         </children>
      </VBox>

      <VBox spacing="12.0" HBox.hgrow="ALWAYS">
         <children>

      <!-- Mesa: animação, saldo e resultado -->
      <VBox alignment="CENTER" spacing="8.0" styleClass="mesa-cassino">
         <children>
            <Label fx:id="labelSaldoCassino" styleClass="mesa-saldo" />
            <PalcoCassino fx:id="palco" />
            <Label fx:id="labelResultado" minHeight="20.0" wrapText="true" />
            <Button fx:id="botaoRetirar" managed="false" minWidth="220.0" mnemonicParsing="false" onAction="#retirarAgora" styleClass="botao-retirar" text="RETIRAR" visible="false" />
         </children>
      </VBox>

      <!-- Histórico -->
      <VBox spacing="8.0" styleClass="content-card" VBox.vgrow="ALWAYS">
         <children>
            <VBox spacing="2.0">
               <children>
                  <Label styleClass="card-title" text="Últimas apostas" />
                  <Label fx:id="labelResumo" styleClass="card-subtitle" text="Nenhuma aposta nesta conta" />
               </children>
            </VBox>
            <TableView fx:id="tabelaApostas" fixedCellSize="36.0" styleClass="transactions-table" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colunaJogo" prefWidth="110.0" text="JOGO" />
                  <TableColumn fx:id="colunaValor" prefWidth="90.0" text="APOSTA" />
                  <TableColumn fx:id="colunaSorteio" prefWidth="210.0" minWidth="175.0" text="SORTEIO" />
                  <TableColumn fx:id="colunaResultado" prefWidth="100.0" minWidth="100.0" text="RESULTADO" />
                  <TableColumn fx:id="colunaData" prefWidth="95.0" text="DATA" />
               </columns>
            </TableView>
         </children>
      </VBox>

         </children>
      </VBox>

   </children>
</HBox>